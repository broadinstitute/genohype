{
  "name": "@genohype/association-viz",
  "version": "0.1.0",
  "description": "Reusable, manifest-driven association visualizations",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist"],
  "scripts": {
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "build": "npm run contracts:check && tsc && cp src/styles.css dist/styles.css && node scripts/verify-build.mjs",
    "typecheck": "npm run contracts:check && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run contracts:check && vitest run"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^5.9.3"
  },
  "license": "MIT"
}
